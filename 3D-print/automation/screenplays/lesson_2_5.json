    {
      "section": "Print Orientation",
      "type": "eval",
      "script": "document.body.style.cssText = 'margin:0; background: #0A0A0F; display: flex; align-items: center; justify-content: center; height: 100vh; font-family: Inter, Segoe UI, sans-serif;'; document.body.innerHTML = '<div style=\"text-align:center; max-width:800px\"><div style=\"font-size:36px; font-weight:700; color:#ef4444; margin-bottom:30px\">⚠️ Print Orientation — Critical!</div><div style=\"background:rgba(239,68,68,0.1); padding:40px; border-radius:16px; border:1px solid rgba(239,68,68,0.3)\"><div style=\"font-size:20px; color:#fff; line-height:2; text-align:left\">Clips MUST flex <span style=\"color:#22c55e; font-weight:700\">perpendicular</span> to layer lines<br><br><span style=\"color:#ef4444\">❌ Flex along layer lines → delamination → snap off</span><br><span style=\"color:#22c55e\">✅ Flex across layer lines → strong, reliable</span><br><br>Print frames flat on bed with clips pointing upward<br>→ Correct orientation is automatic!</div></div></div>';",
