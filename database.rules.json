{
  "rules": {

    "approved_users": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'ajayadesign@gmail.com')",
        ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
        ".validate": "newData.hasChildren(['email', 'tier']) && newData.child('tier').isString() && newData.child('tier').val().matches(/^(stl|course|session|bundle)$/)"
      }
    },

    "pending_users": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || auth.token.email === 'ajayadesign@gmail.com')",
        ".validate": "newData.hasChildren(['email', 'requested_at']) || !newData.exists()"
      }
    },

    "courses": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "progress": {
          "$key": {
            ".validate": "newData.isBoolean() && ($key.matches(/^module-[1-6]$/) || $key.matches(/^lesson-[1-6]-[1-9][0-9]?$/))"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "pre_approved": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".indexOn": ["email"]
    },

    "email_queue": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'"
    },

    "site_analytics": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".write": true,
      ".validate": "newData.isString() || newData.hasChildren()",
      "sessions": { "$date": { "$entry": { ".validate": "newData.hasChildren(['page','ts'])" } } },
      "presence": { "$sid": { ".validate": "newData.hasChildren(['page'])" } },
      "pageviews": { "$date": { "$page": { ".validate": "newData.isNumber()" } } },
      "clicks":    { "$date": { "$page": { "$el":   { ".validate": "newData.isNumber()" } } } },
      "scroll":    { "$date": { "$page": { ".validate": "newData.isNumber()" } } },
      "perf":      { "$date": { "$page": { ".validate": "newData.isNumber()" } } },
      "referrers": { "$date": { "$ref":  { ".validate": "newData.isNumber()" } } }
    },

    "leads": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      "$leadId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['email']) && newData.child('email').isString() && newData.child('email').val().length < 256"
      }
    },

    "builds": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'"
    },

    "quote_viewer": {
      "$token": {
        ".read": true,
        ".write": "!data.exists() || (auth != null && auth.token.email === 'ajayadesign@gmail.com')",
        ".validate": "newData.hasChildren()"
      }
    },

    "quotes": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      "$quoteId": {
        ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'"
      }
    },

    "signing": {
      "$token": {
        ".read": true,
        ".write": "!data.child('signed').exists() || (auth != null && auth.token.email === 'ajayadesign@gmail.com')",
        ".validate": "newData.hasChildren()"
      }
    },

    "contracts": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'"
    },

    "portfolio": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'"
    },

    "parse_requests": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'"
    },

    "activity_logs": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'"
    },

    "commands": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'"
    },

    "outreach": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'"
    },

    "drone": {
      ".read": "auth != null && auth.token.email === 'ajayadesign@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ajayadesign@gmail.com'"
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
